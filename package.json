{
  "name": "whoiswho",
  "private": true,
  "version": "1.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/lib/**\" --test-coverage-include=\"scripts/audio-lib.mjs\" --test-coverage-include=\"scripts/vite-audio-plugin.mjs\" --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100 \"tests/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:all": "npm run test:coverage && npm run test:e2e",
    "audio": "node scripts/generate-audio.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "devDependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "@playwright/test": "^1.65.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "svelte": "^5.57.3",
    "vite": "^8.3.7",
    "vite-plugin-pwa": "^2.0.0"
  }
}
